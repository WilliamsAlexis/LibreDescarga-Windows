{
  "manifest_version": 3,
  "name": "LibreDescarga — Integración con el navegador",
  "short_name": "LibreDescarga",
  "version": "1.3.0",
  "description": "Envía enlaces de descarga a la aplicación LibreDescarga (gestor de descargas acelerado).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LibreDescarga",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "contextMenus",
    "storage",
    "downloads",
    "cookies",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
