{
  "manifest_version": 3,
  "name": "LibreDescarga — Integración con el navegador",
  "short_name": "LibreDescarga",
  "version": "1.1.0",
  "description": "Envía enlaces de descarga a la aplicación LibreDescarga (gestor de descargas acelerado).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LibreDescarga",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "contextMenus",
    "storage",
    "downloads",
    "cookies",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.vimeo.com/*",
        "*://*.dailymotion.com/*",
        "*://*.twitch.tv/*",
        "*://*.tiktok.com/*",
        "*://*.soundcloud.com/*",
        "*://*.bandcamp.com/*",
        "*://*.twitter.com/*",
        "*://x.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
